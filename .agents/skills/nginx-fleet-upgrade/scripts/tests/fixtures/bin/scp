#!/usr/bin/env python3
import json
import os
import sys
from pathlib import Path

args = sys.argv[1:]
if len(args) < 2:
    sys.exit(2)
source, destination = args[-2], args[-1]
scenario_path = os.environ.get("FLEET_FAKE_SCENARIO")
scenario = json.loads(Path(scenario_path).read_text()) if scenario_path and Path(scenario_path).is_file() else {}

if "@" in source and ":" in source:
    Path(destination).parent.mkdir(parents=True, exist_ok=True)
    payload = b"" if scenario.get("backup_empty") else b"fake-nginx-tarball"
    Path(destination).write_bytes(payload)
sys.exit(0)
