#!/usr/bin/env python3
import json
import os
import sys
from pathlib import Path

scenario_path = os.environ.get("FLEET_FAKE_SCENARIO")
scenario = json.loads(Path(scenario_path).read_text()) if scenario_path and Path(scenario_path).is_file() else {}

if "compute" in sys.argv and "droplet" in sys.argv:
    print(json.dumps(scenario.get("doctl", [])))
    sys.exit(0)
if "auth" in sys.argv:
    if scenario.get("doctl_auth", True):
        print("access token ok")
        sys.exit(0)
    print("no auth", file=sys.stderr)
    sys.exit(1)
sys.exit(0)
